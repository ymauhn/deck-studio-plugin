{
  "description": "Deck Studio: a guarda de escrita nos projetos de apresentação",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --no-project --python 3.12 python \"${CLAUDE_PLUGIN_ROOT}/server/deck_tools/guarda.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
